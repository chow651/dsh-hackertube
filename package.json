{
  "name": "dsh-hackertube",
  "version": "0.1.0",
  "description": "HackerTube 面板：Hacker News 二十年里被反复推荐的 6454 个视频",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hackertube",
    "hacker-news",
    "youtube"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chow651/dsh-hackertube.git"
  },
  "homepage": "https://github.com/chow651/dsh-hackertube#readme",
  "bugs": {
    "url": "https://github.com/chow651/dsh-hackertube/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "data/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/host-smoke.mjs && node test/client-render.mjs client.js"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
